# What the shared packaging (tools/verdite-core/packaging) calls this port.
# Read by the AppImage script, the Windows script and its installer, and
# scripts/release.sh; one KEY=VALUE a line, for bash and PowerShell alike.
NAME=Deception2
APP_ID=deception2
# The apphost under bin\ and usr/bin. The game assembly is Deception, so the
# launcher assembly cannot share that simple name: LoadFromAssemblyPath would
# find the one already in the process. The stub the player double-clicks is
# still NAME.exe. The project directory is NAME.Launcher.
LAUNCHER_ASSEMBLY=Deception2Launcher
# The Inno Setup AppId: how Windows tells an upgrade of this port from another
# program, including Tecmo's Deception (C4E8A1D7-6B25-4F93-8E0A-2D7C5B91F6A4).
# Never change it, and never give another port this one.
INNO_APP_ID=2DF781D8-6A55-4D26-9E07-A60DD3EA73BB
# A per-user install: its shortcuts are the player's, so the game can point them
# at the card icon it reads off the disc. See "The shortcuts wear it too" in docs/PACKAGING.md.
INNO_PRIVILEGES=lowest
